# ============================================================
# Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ============================================================

# PostgreSQL (Aiven free tier)
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb

# Ethereum RPC (Sepolia testnet)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# JWT RS256 key passphrase (used to decrypt private.pem)
PRIVATE_KEY_PASSPHRASE=your-passphrase

# Environment: "development" or "production"
# In production, cookies are set with secure=true
NODE_ENV=development

# Email (Gmail SMTP for verification / password reset)
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Server port (Railway sets this automatically; only needed locally)
PORT=3333

# CORS origin (set to your Vercel frontend URL in production)
# e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
